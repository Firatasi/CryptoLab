# =============================================================================
# CryptoLab Monorepo — Kapsamli .gitignore (Backend + Frontend + AI + Infra)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GUVENLIK, SIRLAR VE ORTAM DEGISKENLERI (KRITIK)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!**/.env.example
!**/.env.*.example
!**/.env.template
!**/.env.sample

# Sertifika, Private Key ve Keystore dosyalari
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.csr

# Kimlik ve Secret yapilandirmalari
secrets/
.secrets/
secrets.*
*credentials*.json
*service-account*.json
application-local.properties
application-local.yml
application-secret*.properties
application-secret*.yml

# -----------------------------------------------------------------------------
# 2. BACKEND (Java 21 / Spring Boot / Maven)
# -----------------------------------------------------------------------------
**/target/
target/
*.class
*.war
*.nar
*.ear
*.jar
!**/wrapper/maven-wrapper.jar

# JVM Crash ve Dump kayitlari
hs_err_pid*
replay_pid*
*.hprof
*.dump

# Maven ve Spring araclari
.mtj.tmp/
.SpringBeans
.sts4-cache/
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
**/.github/modernize/

# -----------------------------------------------------------------------------
# 3. FRONTEND (React / Vite / TypeScript / Node.js)
# -----------------------------------------------------------------------------
**/node_modules/
node_modules/
**/.next/
.next/
**/out/
out/
**/dist/
dist/
**/build/
build/

# TypeScript, Vite / Vitest ve Lint Cache
.vite/
**/.vite/
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache
.turbo/
.vercel/
.netlify/
.parcel-cache/

# Paket yoneticisi loglari ve PnP
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.js
.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# Test ve Coverage
**/coverage/
.nyc_output/
test-results/
playwright-report/

# -----------------------------------------------------------------------------
# 4. AI, VERI BILIMI VE SOZLESME TESTLERI (Python / FastAPI / ML)
# -----------------------------------------------------------------------------
# Sanal ortamlar
.contracts-venv/
**/venv/
**/.venv/
**/.venv-*/
**/.venv_*/
**/env/
ENV/
env.bak/
venv.bak/

# Python derleme ve cache
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Test, Linter ve Tip kontrol araclari
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter, ML Model Agirliklari ve Uretilen Artifact'ler
.ipynb_checkpoints/
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.pkl
*.joblib
*.safetensors
weights/
ai/weights/
artifacts/
**/artifacts/
**/.huggingface/

# FastAPI / Celery calisma dosyalari
celerybeat-schedule
celerybeat.pid

# -----------------------------------------------------------------------------
# 5. VERITABANI, DOCKER, DEPLOYMENT VE GECICI DOSYALAR
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
dump.rdb

# Yerel container volume klasorleri
postgres-data/
kafka-data/
redis-data/
docker-volumes/
infra/data/
docker-compose.override.yml

# Hugging Face Space gecici staging dizini
deploy/.hf-staging/

# Loglar ve Gecici dosyalar
*.log
logs/
**/logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Kisisel calisma notlari
tezke.txt

# -----------------------------------------------------------------------------
# 6. IDE, EDITOR VE ISLETIM SISTEMI (OS)
# -----------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, PyCharm, WebStorm)
.idea/
**/.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
**/.vscode/
!**/extensions.json

# Eclipse / NetBeans
.classpath
.project
.settings/
.project/

# macOS / Windows / Linux
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
