# CryptoLab Training & Ingestion Dockerfile (Training Runtime)
FROM python:3.12-slim

WORKDIR /service

COPY requirements-training.lock.txt ./
RUN pip install --no-cache-dir -r requirements-training.lock.txt

RUN useradd --uid 10002 --create-home appuser

COPY app ./app
COPY configs ./configs

USER appuser

EXPOSE 8092

CMD ["uvicorn", "app.api.training_api:create_training_app", "--host", "0.0.0.0", "--port", "8092", "--factory"]

