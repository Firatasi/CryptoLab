# CryptoLab Production Environment Variables Template
# Generate secrets with: openssl rand -hex 32
# Activate Spring `prod` profile via: SPRING_PROFILES_ACTIVE=prod and APP_ENV=production

SPRING_PROFILES_ACTIVE=prod
APP_ENV=production

# Public origin & cookie security (must use https://)
WEB_ORIGIN=https://cryptolab.example.com
APP_WEB_ORIGIN=https://cryptolab.example.com
COOKIE_SECURE=true
TRUST_FORWARDED_HEADERS=true

# Database credentials (unique least-privilege password per DB role)
DB_URL=jdbc:postgresql://127.0.0.1:5432/postgres
DB_USERNAME=cryptolab_app
DB_PASSWORD=__REPLACE_WITH_STRONG_DB_PASSWORD__

# RSA JWT key paths (chmod 600 on private key; never commit to git)
JWT_ISSUER=https://cryptolab.example.com
JWT_AUDIENCE=cryptolab-api
JWT_PRIVATE_KEY_PATH=/etc/cryptolab/keys/private.pem
JWT_PUBLIC_KEY_PATH=/etc/cryptolab/keys/public.pem
JWT_JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json

# Mandatory minimum 32+ char high-entropy cryptographic secrets
REGISTRATION_HASH_KEY=__GENERATE_64_HEX_CHARS__
MODEL_SERVICE_SECRET=__GENERATE_64_HEX_CHARS__
TRAINING_SERVICE_SECRET=__GENERATE_64_HEX_CHARS__
REPORTING_CURSOR_SECRET=__GENERATE_64_HEX_CHARS__

# Bootstrap admin account (override default before first production startup!)
ADMIN_BOOTSTRAP_EMAIL=admin@cryptolab.example.com
ADMIN_BOOTSTRAP_PASSWORD=__GENERATE_STRONG_MIN_16_CHAR_PASSWORD__

# Optional URL importer host allowlist (comma-separated HTTPS hosts)
TRAINING_ALLOWED_IMPORT_HOSTS=research.cryptolab.org

# SQL logging off in production
SHOW_SQL=false
FORMAT_SQL=false
